<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Pixoro Chat</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0/dist/umd/supabase.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}
body{background:#000;color:#fff;max-width:450px;margin:0 auto;height:100vh;display:flex;flex-direction:column}
.top{padding:12px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #222;background:#000;position:sticky;top:0}
.left{display:flex;align-items:center;gap:10px}
.left img{width:34px;height:34px;border-radius:50%}
.msgArea{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:6px;background:#000}
.bub{max-width:75%;padding:10px 14px;border-radius:18px;font-size:14.5px;word-break:break-word}
.me{align-self:flex-end;background:#0095f6;color:#fff;border-bottom-right-radius:4px}
.other{align-self:flex-start;background:#262626;color:#fff;border-bottom-left-radius:4px}
.inputBox{display:flex;align-items:center;gap:10px;padding:10px;border-top:1px solid #222;background:#000}
.inputBox input{flex:1;background:#262626;border:0;padding:10px 14px;border-radius:20px;color:#fff;outline:none}
.send{color:#0095f6;font-weight:700;cursor:pointer}
.time{font-size:10px;color:#888;margin-top:2px}
</style>
</head>
<body>

<div class="top">
  <div class="left">
    <span onclick="location.href='dm.html'" style="font-size:22px;cursor:pointer">←</span>
    <img id="pfp" src="">
    <div><b id="uname"></b><div style="font-size:11px;color:#0f0">Active now • Pixoro</div></div>
  </div>
  <div style="font-size:20px;cursor:pointer" onclick="alert('Call feature soon da!')">📞</div>
</div>

<div class="msgArea" id="chatBox"></div>
<div id="typing" style="padding:0 14px 6px;font-size:12px;color:#888;display:none"></div>

<div class="inputBox">
  <input id="msgInput" placeholder="Message..." onkeydown="if(event.key==='Enter')sendMsg()">
  <span class="send" onclick="sendMsg()">Send</span>
</div>

<script>
const supa = window.supabase.createClient('https://yecpltndhlzfjplzhcpm.supabase.co','sb_publishable_byUfZPczrxfkYKTmUNco5w_oqabYQJ_')

// ME yaaru?
let ME = localStorage.getItem('pixoro_current_user') || prompt('Un name enna da?') || 'Giri'
localStorage.setItem('pixoro_current_user', ME)

// OTHER yaaru? URL la irunthu varum da ?user=Name
let OTHER = new URLSearchParams(location.search).get('user')
if(!OTHER){ alert('User illa da! dm.html la irunthu va da!'); OTHER='Friend' }

document.getElementById('uname').innerText = OTHER
document.getElementById('pfp').src = `https://i.pravatar.cc/100?u=${OTHER}`

let chatId = [ME, OTHER].sort().join('_') // Giri_Siva maari

async function loadMsgs(){
  let {data} = await supa.from('messages').select('*').eq('chat_id', chatId).order('created_at',{ascending:true})
  let box = document.getElementById('chatBox')
  if(!data || !data.length){
    box.innerHTML = `<div style="text-align:center;color:#555;margin-top:100px">No messages yet da!<br>Say Hi to ${OTHER} 👋</div>`
    return
  }
  box.innerHTML = data.map(m=>{
    let isMe = m.sender===ME
    return `<div class="${isMe?'me':'other'} bub" style="align-self:${isMe?'flex-end':'flex-start'}">${m.text}<div class="time" style="color:${isMe?'#d0e8ff':'#888'}">${new Date(m.created_at).toLocaleTimeString()} ${isMe && m.seen?'• Seen':''}</div></div>`
  }).join('')
  box.scrollTop = box.scrollHeight

  // Seen aakku da!
  await supa.from('messages').update({seen:true}).eq('chat_id',chatId).eq('receiver',ME)
}

async function sendMsg(){
  let inp = document.getElementById('msgInput')
  let text = inp.value.trim()
  if(!text) return
  inp.value=''

  // Optimistic - udane kaamikku da!
  let box = document.getElementById('chatBox')
  box.innerHTML += `<div class="me bub">${text}<div class="time">now</div></div>`
  box.scrollTop = box.scrollHeight

  // Supabase la save da - ITHU THAN REAL CHAT DA!
  let {error} = await supa.from('messages').insert({
    chat_id: chatId,
    sender: ME,
    receiver: OTHER,
    text: text
  })
  if(error) alert('Error da: '+error.message)
}

// REALTIME - Adutha aal message panna udane varum da!
supa.channel('chat-'+chatId).on('postgres_changes',{event:'INSERT',schema:'public',table:'messages',filter:`chat_id=eq.${chatId}`},()=>{loadMsgs()}).subscribe()

loadMsgs()
</script>
</body>
</html>
