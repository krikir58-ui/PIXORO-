<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Chat - Pixoro</title>
<link rel="stylesheet" href="css/pixoro-verified.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0/dist/umd/supabase.min.js"></script>
<script src="js/supabase.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,sans-serif}body{background:#000;color:#fff;max-width:450px;margin:0 auto;height:100vh;display:flex;flex-direction:column}
.top{padding:12px 14px;display:flex;gap:10px;align-items:center;border-bottom:1px solid #262626;background:#000;position:sticky;top:0;z-index:50}
.top img{width:32px;height:32px;border-radius:50%;object-fit:cover}
.top b{font-size:15px;display:flex;align-items:center;gap:4px}
.top small{font-size:11px;color:#0095f6}
.box{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px;padding-bottom:20px}
.bub{max-width:75%;padding:10px 14px;border-radius:22px;font-size:14px;line-height:1.4}
.me{align-self:flex-end;background:#0095f6;color:#fff;border-bottom-right-radius:4px}
.other{align-self:flex-start;background:#262626;color:#fff;border-bottom-left-radius:4px}
.input{display:flex;gap:8px;padding:12px;background:#000;border-top:1px solid #262626;position:sticky;bottom:0;align-items:center}
.input input{flex:1;background:#262626;border:none;padding:12px 16px;border-radius:24px;color:#fff;outline:none;font-size:14px}
.sendBtn{background:#fff;color:#000;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:900}
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#fff;color:#000;padding:10px 16px;border-radius:20px;font-size:13px;font-weight:700;z-index:999;display:none}
</style>
</head><body>
<div class="top"><span onclick="location.href='dm.html'" style="font-size:24px;cursor:pointer">←</span><img id="pfp" src=""><div><b id="uname"></b><br><small style="color:#0095f6">● Active now • Pixoro</small></div><span style="margin-left:auto;font-size:18px">📞 📹</span></div>
<div class="box" id="box"></div>
<div class="input"><input id="inp" placeholder="Message..." onkeydown="if(event.key==='Enter')send()"><span onclick="send()" class="sendBtn">➤</span></div>
<div id="toast" class="toast"></div>
<script>
function showToast(m){let t=document.getElementById('toast');if(!t) return; t.innerText=m; t.style.display='block'; setTimeout(()=>t.style.display='none',2000)}
let supa = window.supa
function cleanUser(u){ if(!u) return ''; u=String(u).trim(); if(u.includes('@')) u=u.split('@')[0]; return u.replace(/[^a-zA-Z0-9_.]/g,'').toLowerCase()||'' }
let ME='', OTHER=cleanUser(new URLSearchParams(location.search).get('user')||'')
let chatId=''
async function init(){
  if(!supa || !OTHER){ location.href='dm.html'; return }
  let { data:{session} } = await supa.auth.getSession()
  if(!session){ location.href='login.html'; return }
  let { data: myProf } = await supa.from('profiles').select('*').eq('id', session.user.id).single()
  ME = cleanUser(myProf?.username || session.user.email.split('@')[0])
  let { data: otherProf } = await supa.from('profiles').select('*').eq('username', OTHER).maybeSingle()
  document.getElementById('uname').innerHTML = '@'+OTHER+' '+(window.getTick?window.getTick(OTHER):'')
  document.getElementById('pfp').src = otherProf?.avatar_url || 'https://ui-avatars.com/api/?name='+OTHER.charAt(0).toUpperCase()+'&background=333&color=fff&size=200&bold=true'
  chatId=[ME,OTHER].sort().join('_')
  supa.channel('chat-'+chatId).on('postgres_changes',{event:'INSERT',schema:'public',table:'messages',filter:`chat_id=eq.${chatId}`},load).subscribe()
  load()
}
async function load(){
  let {data} = await supa.from('messages').select('*').eq('chat_id',chatId).order('created_at',{ascending:true})
  let b=document.getElementById('box')
  if(!data||!data.length){ b.innerHTML=`<div style="text-align:center;color:#555;margin-top:100px">Say hi to @${OTHER} 👋<br><span style="font-size:11px;color:#333">Pixoro • Secure Chat</span></div>`; return }
  b.innerHTML=data.map(m=>`<div class="${m.sender===ME?'me':'other'} bub">${m.text}</div>`).join('')
  b.scrollTop=b.scrollHeight
}
async function send(){
  let i=document.getElementById('inp'); let t=i.value.trim(); if(!t) return; i.value=''
  document.getElementById('box').innerHTML+=`<div class="me bub">${t}</div>`; document.getElementById('box').scrollTop=document.getElementById('box').scrollHeight
  let {error} = await supa.from('messages').insert({chat_id:chatId,sender:ME,receiver:OTHER,text:t})
  if(error) showToast('Adutha side la problem da')
}
init()
</script></body></html>
