<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Chat</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0/dist/umd/supabase.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}body{background:#000;color:#fff;max-width:450px;margin:0 auto;height:100vh;display:flex;flex-direction:column}
.top{padding:12px 14px;display:flex;gap:10px;align-items:center;border-bottom:1px solid #222;background:#000}
.top img{width:32px;height:32px;border-radius:50%}
.box{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px;padding-bottom:20px}
.bub{max-width:75%;padding:10px 14px;border-radius:18px;font-size:14px}
.me{align-self:flex-end;background:#0095f6;border-bottom-right-radius:4px}
.other{align-self:flex-start;background:#262626;border-bottom-left-radius:4px}
.input{display:flex;gap:8px;padding:12px;background:#000;border-top:1px solid #222;position:sticky;bottom:0}
.input input{flex:1;background:#1a1a1a;border:1px solid #333;padding:12px 16px;border-radius:24px;color:#fff;outline:none}
</style>
</head><body>
<div class="top"><span onclick="location.href='dm.html'" style="font-size:24px;cursor:pointer">←</span><img id="pfp" src=""><b id="uname"></b><span style="margin-left:auto">📞 📹</span></div>
<div class="box" id="box"></div>
<div class="input"><input id="inp" placeholder="Message..." onkeydown="if(event.key==='Enter')send()"><span onclick="send()" style="background:#fff;color:#000;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer">➤</span></div>
<script>
const supa=window.supabase.createClient('https://yecpltndhlzfjplzhcpm.supabase.co','sb_publishable_byUfZPczrxfkYKTmUNco5w_oqabYQJ_')
let ME=localStorage.getItem('pixoro_current_user')||'Giri'
let OTHER=new URLSearchParams(location.search).get('user')||'Friend'
document.getElementById('uname').innerText=OTHER
document.getElementById('pfp').src=`https://i.pravatar.cc/100?u=${OTHER}`
let chatId=[ME,OTHER].sort().join('_')
async function load(){let {data}=await supa.from('messages').select('*').eq('chat_id',chatId).order('created_at',{ascending:true});let b=document.getElementById('box'); if(!data||!data.length){b.innerHTML=`<div style="text-align:center;color:#555;margin-top:100px">Say hi to ${OTHER} 👋</div>`;return} b.innerHTML=data.map(m=>`<div class="${m.sender===ME?'me':'other'} bub">${m.text}</div>`).join(''); b.scrollTop=b.scrollHeight}
async function send(){let i=document.getElementById('inp');let t=i.value.trim(); if(!t) return; i.value=''; document.getElementById('box').innerHTML+=`<div class="me bub">${t}</div>`; document.getElementById('box').scrollTop=document.getElementById('box').scrollHeight; await supa.from('messages').insert({chat_id:chatId,sender:ME,receiver:OTHER,text:t})}
supa.channel('chat-'+chatId).on('postgres_changes',{event:'INSERT',schema:'public',table:'messages',filter:`chat_id=eq.${chatId}`},load).subscribe()
load()
</script>
</body></html>
