<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Pixoro Chat</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0/dist/umd/supabase.min.js"></script>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}body{background:#000;color:#fff;max-width:450px;margin:0 auto;height:100vh;display:flex;flex-direction:column;overflow:hidden}
.top{padding:12px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #222;background:#000}
.chat{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:8px}
.bubble{max-width:72%;padding:10px 14px;font-size:14.5px;line-height:1.3;position:relative;word-wrap:break-word;cursor:pointer}
.me{align-self:flex-end;color:#fff;border-radius:18px 18px 4px 18px}
.other{align-self:flex-start;background:#262626;color:#fff;border-radius:18px 18px 18px 4px}
.seen{align-self:flex-end;display:flex;gap:4px;align-items:center;color:#888;font-size:11px;margin-top:2px}
.typing{color:#888;font-size:12px;padding:0 14px 4px;display:none}
.inputBar{padding:10px 12px;display:flex;align-items:center;gap:10px;border-top:1px solid #1a1a1a;background:#000}
.inputBox{flex:1;background:#262626;border-radius:22px;padding:8px 14px;display:flex;align-items:center}
.inputBox input{flex:1;background:transparent;border:0;color:#fff;outline:none;font-size:14px}
.reactMenu{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);background:#222;border-radius:20px;padding:6px 10px;display:flex;gap:8px;z-index:5}
</style></head><body>
<div class="top"><div style="display:flex;align-items:center;gap:12px"><span onclick="location.href='dm.html'" style="font-size:22px;cursor:pointer">←</span><img id="pfp" style="width:32px;height:32px;border-radius:50%"><div><b id="name"></b><div id="status" style="color:#999;font-size:11px">Active now</div></div></div><div style="display:flex;gap:16px;font-size:20px"><span>📞</span><span>🎥</span><span onclick="location.href='chat-info.html?user='+OTHER" style="cursor:pointer">ℹ️</span></div></div>
<div class="chat" id="chatBox"></div>
<div id="typingBox" class="typing"></div>
<div id="disBar" style="display:none;background:#111;padding:8px 14px;text-align:center;color:#888;font-size:12px">🌙 Disappearing mode ON</div>
<div class="inputBar"><span>😊</span><div class="inputBox"><input id="msgInput" placeholder="Message..." oninput="sendTyping()" onkeydown="if(event.key==='Enter')sendMsg()"><span style="margin-left:8px">🎙️</span><span style="margin-left:8px">🖼️</span></div><span onclick="sendMsg()" style="color:#FF0A33;font-weight:700;cursor:pointer">Send</span></div>
<script>
const supa=window.supabase.createClient('https://yecpltndhlzfjplzhcpm.supabase.co','sb_publishable_byUfZPczrxfkYKTmUNco5w_oqabYQJ_')
const ME=localStorage.getItem('pixoro_current_user')||'Giri'
const OTHER=new URLSearchParams(location.search).get('user')||'Siva'
const chatId=[ME,OTHER].sort().join('_')
document.getElementById('name').innerText=OTHER
document.getElementById('pfp').src=`https://i.pravatar.cc/100?u=${OTHER}`
function getGradient(){let g=['linear-gradient(135deg,#7F00FF,#E100FF)','linear-gradient(135deg,#FF6A00,#FF0A33)','linear-gradient(135deg,#0095f6,#00d4ff)'];return g[OTHER.charCodeAt(0)%g.length]}
let disappearOn=localStorage.getItem('pixoro_disappear_'+OTHER)==='true'
if(disappearOn){document.getElementById('disBar').style.display='block';document.getElementById('status').innerText='Disappearing messages ON'}
async function loadMessages(){
  let {data}=await supa.from('messages').select('*').eq('chat_id',chatId).order('created_at',{ascending:true}).limit(100)
  let box=document.getElementById('chatBox')
  if(!data||!data.length){box.innerHTML=`<div style="text-align:center;color:#666;margin-top:40px"><img src="https://i.pravatar.cc/80?u=${OTHER}" style="width:80px;height:80px;border-radius:50%"><div style="margin-top:10px;font-weight:700">${OTHER}</div><div style="font-size:11px;color:#444">Tap and hold to react</div></div>`;return}
  box.innerHTML=data.map(m=>{
    let isMe=m.sender===ME;let heart=m.reaction?`<div style="font-size:12px;margin-top:2px">${m.reaction}</div>`:''
    return isMe?`<div style="align-self:flex-end;max-width:72%"><div class="bubble me" style="background:${getGradient()}" onmousedown="startReact('${m.id}')" ontouchstart="startReact('${m.id}')">${m.text}${heart}</div></div>`:`<div style="align-self:flex-start;display:flex;gap:8px;align-items:flex-end"><img src="https://i.pravatar.cc/24?u=${OTHER}" style="width:24px;height:24px;border-radius:50%"><div class="bubble other" onmousedown="startReact('${m.id}')" ontouchstart="startReact('${m.id}')">${m.text}${heart}</div></div>`
  }).join('') + (data.some(m=>m.seen&&m.sender===ME&&localStorage.getItem('pixoro_read')!=='false')?`<div class="seen"><span>Seen</span><img src="https://i.pravatar.cc/20?u=${OTHER}" style="width:14px;height:14px;border-radius:50%"></div>`:'')
  box.scrollTop=box.scrollHeight;await supa.from('messages').update({seen:true}).eq('chat_id',chatId).eq('receiver',ME).eq('seen',false)
}
async function sendMsg(){let inp=document.getElementById('msgInput');let t=inp.value.trim();if(!t) return;inp.value='';let box=document.getElementById('chatBox');box.innerHTML+=`<div style="align-self:flex-end;max-width:72%"><div class="bubble me" style="background:${getGradient()}">${t}</div></div>`;box.scrollTop=box.scrollHeight;await supa.from('messages').insert({chat_id:chatId,sender:ME,receiver:OTHER,text:t,seen:false});loadMessages()}
function sendTyping(){if(localStorage.getItem('pixoro_typing')==='false') return;supa.channel(chatId).send({type:'broadcast',event:'typing',payload:{user:ME}})}
supa.channel(chatId).on('broadcast',{event:'typing'},(p)=>{if(p.payload.user!==ME){let b=document.getElementById('typingBox');b.style.display='block';b.innerText=`${OTHER} typing...`;setTimeout(()=>b.style.display='none',1500)}}).subscribe()
supa.channel('msg-'+chatId).on('postgres_changes',{event:'*',schema:'public',table:'messages',filter:`chat_id=eq.${chatId}`},()=>loadMessages()).subscribe()
let rt;function startReact(id){rt=setTimeout(()=>showReact(id),500)};function showReact(id){let em=['❤️','😂','😮','😢','🙏','🔥'];let m=document.createElement('div');m.className='reactMenu';m.innerHTML=em.map(e=>`<span style="font-size:22px;cursor:pointer" onclick="doReact('${id}','${e}')">${e}</span>`).join('');document.getElementById('chatBox').appendChild(m);setTimeout(()=>m.remove(),3000)}
async function doReact(id,emoji){document.querySelectorAll('.reactMenu').forEach(x=>x.remove());await supa.from('messages').update({reaction:emoji}).eq('id',id);loadMessages()}
loadMessages()
</script></body></html>
